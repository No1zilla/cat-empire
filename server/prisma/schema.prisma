datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

model User {
  id               String   @id @default(uuid())
  vkId             BigInt   @unique
  firstName        String   @default("")
  lastName         String   @default("")
  avatar           String   @default("")
  coins            Float    @default(100)      // Текущий баланс монет
  gems             Int      @default(10)       // Текущий баланс гемов
  maxCatLevel      Int      @default(1)        // Максимальный уровень открытого котика
  gridState        String   @default("[]")     // JSON-строка состояния ячеек (массив объектов {slotIndex, catLevel})
  lastOfflineCheck DateTime @default(now())    // Время последнего начисления доходности
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
